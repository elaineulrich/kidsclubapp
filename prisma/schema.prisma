generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VOLUNTEER
}

/// Single-row table for org-wide configuration set from the admin Settings page.
model Setting {
  id       String @id @default("singleton")
  timezone String @default("America/Chicago")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  CHECKED_OUT
}

enum RouteStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  COMPLETED
  SKIPPED
}

enum Recurrence {
  NONE
  WEEKLY
  BIWEEKLY
}

/// Admin & Check-In Volunteer accounts (drivers authenticate separately via login code)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VOLUNTEER)
  activeStatus Boolean  @default(true)
  createdDate  DateTime @default(now())

  /// Set once the invited user picks their own password; null means the invite is still pending
  /// (passwordHash holds an unusable placeholder until then, so login can't succeed early).
  passwordSetAt        DateTime?
  /// Doubles as the forgot-password token: both flows send the user to the same
  /// /accept-invite link and only differ in whether passwordSetAt was already set.
  inviteTokenHash      String?   @unique
  inviteTokenExpiresAt DateTime?

  attendanceCheckIns Attendance[] @relation("CheckedInByUser")
}

model Family {
  id                           String   @id @default(cuid())
  parentName                   String
  phone                        String
  email                        String?
  address                      String
  /// Apartment/suite/unit number, kept separate from `address` so it doesn't get lost
  /// or mangled when building driver navigation links for multi-unit buildings.
  addressLine2                 String?
  city                         String
  state                        String
  zip                          String
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  createdDate                  DateTime @default(now())

  /// Geocoded once (lazily, the first time a route is auto-sorted by distance) and
  /// reused after that - re-geocoding on every sort would hammer the free geocoding
  /// service and violate its usage policy. Null until then, or if geocoding failed
  /// (e.g. an address that doesn't resolve); cleared automatically if `address` changes.
  lat Float?
  lng Float?

  children Child[]
}

model Child {
  id               String    @id @default(cuid())
  familyId         String
  childName        String
  birthday         DateTime?
  age              Int?
  medicalNotes     String?
  pickupRequired   Boolean   @default(false)
  pickupNotes      String?
  /// Best number to reach someone at during the event itself - may differ from the
  /// family's main phone (e.g. a grandparent doing pickup that day).
  bestContactPhone String?
  /// The van this child normally rides. New events auto-assign this child to this
  /// van; a one-off change for a single event doesn't touch this - only editing it
  /// here (the child's profile) changes their default going forward.
  defaultVanId     String?
  activeStatus     Boolean   @default(true)
  createdDate      DateTime  @default(now())

  family           Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  defaultVan       Van?              @relation(fields: [defaultVanId], references: [id], onDelete: SetNull)
  attendances      Attendance[]
  routeAssignments RouteAssignment[]

  @@index([familyId])
}

model Event {
  id                String     @id @default(cuid())
  eventName         String
  eventDate         DateTime
  startTime         String
  endTime           String
  recurrence        Recurrence @default(NONE)
  /// Groups an event with the ones auto-generated from it. Points at the id of the
  /// first event in the series; null on the first event itself (its own id is the
  /// series root).
  seriesId          String?
  /// Set once an admin has reviewed and confirmed this event's routes for drivers.
  routesConfirmedAt DateTime?

  attendances      Attendance[]
  routeAssignments RouteAssignment[]

  @@index([eventDate])
  @@index([seriesId])
}

model Attendance {
  id           String           @id @default(cuid())
  eventId      String
  childId      String
  checkInTime  DateTime?
  checkOutTime DateTime?
  checkedById  String?
  status       AttendanceStatus @default(PRESENT)

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  checkedBy User? @relation("CheckedInByUser", fields: [checkedById], references: [id])

  @@unique([eventId, childId])
  @@index([eventId])
  @@index([childId])
}

model Driver {
  id           String  @id @default(cuid())
  name         String
  phone        String
  email        String?
  loginCode    String  @unique
  activeStatus Boolean @default(true)

  vans             Van[]
  routeAssignments RouteAssignment[]
}

model Van {
  id           String  @id @default(cuid())
  vanName      String
  driverId     String?
  capacity     Int     @default(10)
  activeStatus Boolean @default(true)

  driver             Driver?           @relation(fields: [driverId], references: [id])
  routeAssignments   RouteAssignment[]
  defaultForChildren Child[]
}

model RouteAssignment {
  id        String      @id @default(cuid())
  eventId   String
  driverId  String?
  vanId     String?
  childId   String
  stopOrder Int         @default(0)
  status    RouteStatus @default(UNASSIGNED)

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  driver Driver? @relation(fields: [driverId], references: [id])
  van    Van?    @relation(fields: [vanId], references: [id])
  child  Child   @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([eventId, childId])
  @@index([eventId, vanId])
  @@index([childId])
}
