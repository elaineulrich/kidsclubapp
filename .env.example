# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/kids_club?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Church/organization location used as the starting point for driver routes
CHURCH_ADDRESS="123 Church St, Anytown, ST 00000"

# Resend (https://resend.com) - used to email drivers their route link when an
# admin confirms routes, and to deliver the public website's Registration and
# Contact form submissions. Optional: without RESEND_API_KEY, these features
# still work, they just skip sending email.
RESEND_API_KEY=""
EMAIL_FROM="Haven Kids Club <onboarding@resend.dev>"

# Inbox that receives public website Registration and Contact form submissions.
CONTACT_EMAIL="havenkidsclub@gmail.com"

# Twilio (https://twilio.com) - for texting drivers/parents. Optional: without
# TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN/TWILIO_PHONE_NUMBER, lib/sms.ts's sendSms()
# just returns { sent: false } instead of sending. Nothing in the app calls it yet -
# this is only the plumbing, waiting on which actions should actually trigger a text.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Redis (optional) - caches org settings, admin reports, and driver route data.
# Without REDIS_URL, everything works exactly the same, just without caching.
REDIS_URL=""

# Google Maps JavaScript API key, for the Admin > Map "Kids Map" view. Needs a
# Google Cloud project with the Maps JavaScript API enabled and billing set up
# (Google's free monthly credit covers normal usage for a small app like this).
# Get one at https://console.cloud.google.com/google/maps-apis/credentials.
# Without it, Admin > Map shows a message instead of a map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Google Places API key, for the address search box on the Register form and Admin >
# Families (its house-number coverage is far more complete than the free Nominatim
# search this app falls back to without it). Same Google Cloud project as above -
# just also enable "Places API (New)". Unlike the Maps key, this one is called from
# the server, not the browser, so don't restrict it by HTTP referrer; restrict it to
# just the Places API and, if your host has a static IP, that IP.
# Without it, address search silently falls back to Nominatim.
GOOGLE_PLACES_API_KEY=""
